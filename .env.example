# --- AI (Grok / xAI) ---
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- GitHub (optional; for private repositories) ---
GITHUB_TOKEN=

# --- Security ---
# Production: use a long random string, e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Docker Compose (MySQL) ---
DB_NAME=codecopilot
DB_PASSWORD=root

# --- Backend (optional overrides) ---
# SPRING_PROFILES_ACTIVE=dev|mysql
# SERVER_PORT=8080
# APP_STORAGE_ROOT=./data/repos
# MAX_FILES_PER_REPO=20000
# MAX_REPO_SIZE_BYTES=500000000
# AI_REQUIRE_KEY=false