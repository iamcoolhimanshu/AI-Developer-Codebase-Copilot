# --- AI provider (choose ONE) ---
# Option A – OpenAI (recommended if you have an OpenAI key)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option B – Grok / xAI (OpenAI-compatible)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_EMBEDDING_MODEL=text-embedding-3-small

# Generic fallback (works for either provider, lowest priority)
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_EMBEDDING_MODEL=

# For backward-compat the app also reads XAI_* vars; new code prefers OPENAI_* > XAI_* > AI_*
# Example active config (Grok default):
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- GitHub (optional; for private repositories) ---
GITHUB_TOKEN=

# --- Security ---
# Production: use a long random string, e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Docker Compose (MySQL) ---
DB_NAME=codecopilot
DB_PASSWORD=root

# --- Backend (optional overrides) ---
# SPRING_PROFILES_ACTIVE=dev|mysql
# SERVER_PORT=8080
# APP_STORAGE_ROOT=./data/repos
# MAX_FILES_PER_REPO=20000
# MAX_REPO_SIZE_BYTES=500000000
# AI_REQUIRE_KEY=false
